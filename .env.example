# Copie este arquivo para ".env" e preencha com os seus valores.
# NUNCA envie o arquivo .env para o GitHub (ele já está no .gitignore).

# Banco de dados (Neon Console -> Connection string). Ex.: postgresql://usuario:senha@host.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Google AI Studio (Gemini). Sem chave, o site usa o Motor Algorítmico Local.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Segurança das sessões (gere uma frase longa e aleatória em produção)
SECRET_KEY=

# Endereço público do site (usado nos links de e-mail). Local: http://127.0.0.1:8000
APP_BASE_URL=http://127.0.0.1:8000

# Opcional: identificação legal exibida no rodapé (razão social, CNPJ, cidade, e-mail de contato). Vazio = linha oculta.
EMPRESA_RODAPE=

# Opcional: limite de análises por IP (padrão: 5/minute;10/day)
# LIMITE_ANALISE=5/minute;10/day

# Opcional: defina CONFIAR_PROXY=1 apenas quando o site estiver atrás de proxy reverso confiável
# (Render, Railway, Cloudflare etc.) para que o rate limit use o primeiro IP de X-Forwarded-For.
CONFIAR_PROXY=0

# Opcional: backend de armazenamento do rate limit (padrão: memory://).
# Em produção com múltiplos workers (gunicorn -w 4), o limite só é exato entre processos usando Redis (ex.: redis://localhost:6379/0).
RATE_LIMIT_STORAGE_URI=memory://

# Servidor SMTP para disparo de e-mails transacionais (ex.: smtp.resend.com, smtp.sendgrid.net)
SMTP_HOST=
# Porta do servidor SMTP (587 para STARTTLS ou 465 para SSL direto)
SMTP_PORT=
# Usuário ou chave de API de autenticação no servidor SMTP
SMTP_USER=
# Senha ou token de autenticação no servidor SMTP
SMTP_PASS=
# Remetente dos e-mails, com suporte a nome amigável (ex.: Investidor IA <contato@seudominio.com>)
SMTP_FROM=
